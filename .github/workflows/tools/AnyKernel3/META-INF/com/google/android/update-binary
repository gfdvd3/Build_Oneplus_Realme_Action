# console log
ui_print() { echo "$1"; }
set_perm() { chmod $2 $4; }
set_perm_recursive() { chmod -R $2 $4; }
abort() {
  ui_print "$1";
  exit 1;
}

# find boot block
find_boot() {
  local slot=$(getprop ro.boot.slot_suffix 2>/dev/null || getprop ro.boot.slot 2>/dev/null);
  if [ -z "$slot" ] && [ "$is_slot_device" = "auto" ]; then
    slot=$(getprop ro.boot.slot_suffix 2>/dev/null);
    [ -z "$slot" ] && slot=$(grep -o 'androidboot.slot_suffix=[^ ]*' /proc/cmdline 2>/dev/null | cut -d= -f2);
    is_slot_device=0;
    [ -n "$slot" ] && is_slot_device=1;
  fi;
  [ "$is_slot_device" = "1" ] && local_slot=$slot;

  for block in "$block" /dev/block/by-name/boot$local_slot /dev/block/by-name/boot /dev/block/platform/*/by-name/boot$local_slot /dev/block/platform/*/by-name/boot; do
    [ -e "$block" ] && { boot_block=$block; break; }
  done;
  [ -z "$boot_block" ] && abort "Error: Boot block not found!";
  ui_print "Boot block: $boot_block";

  # find boot image
  local tmpdir=/tmp/ak3;
  rm -rf $tmpdir;
  mkdir -p $tmpdir;
  dd if=$boot_block of=$tmpdir/boot.img 2>/dev/null;
  [ $? -ne 0 ] && abort "Error: Failed to dump boot image!";
  cd $tmpdir;
}

dump_boot() {
  find_boot;
  ui_print "Dumping boot image...";
  $bin/magiskboot unpack -h boot.img 2>/dev/null || abort "Error: Failed to unpack boot image!";

  if [ -f header ]; then
    kernel=Image;
    if [ -f kernel ]; then
      ui_print "Kernel found in boot image";
    fi;
  fi;
}

write_boot() {
  ui_print "Writing boot image...";
  $bin/magiskboot repack boot.img 2>/dev/null || abort "Error: Failed to repack boot image!";
  dd if=new-boot.img of=$boot_block 2>/dev/null || abort "Error: Failed to write boot image!";
  ui_print "Done!";
}

# setup
setup_ak3() {
  local base=/tmp/anykernel;
  mkdir -p $base;
  cd $base;

  # find magiskboot
  local paths="/data/adb/magisk/magiskboot /data/adb/ksu/bin/magiskboot /data/adb/ap/bin/magiskboot";
  for p in $paths; do
    if [ -f "$p" ]; then
      magiskboot=$p;
      break;
    fi;
  done;
  bin=${magiskboot%/*};

  # extract zip
  local zip=$(find /cache /data/adb /data -name "*.zip" -type f 2>/dev/null | head -n 1);
  if [ -z "$zip" ]; then
    # running from recovery - zip is in /tmp
    if [ -f /tmp/update.zip ]; then
      zip=/tmp/update.zip;
    fi;
  fi;
}

setup_ak3;

# import device-specific config
[ -f anykernel.sh ] && . anykernel.sh;

# run device-specific function
if type trim_patchlevel 2>/dev/null | grep -q function; then
  trim_patchlevel;
else
  dump_boot;
  write_boot;
fi;

exit 0;
